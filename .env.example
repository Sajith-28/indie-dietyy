# Copy this file to `.env` and fill in secrets. Do NOT commit `.env` to git.
# Example values shown below. Replace with your real values when deploying.

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority

# Any other secret keys
SECRET_KEY=replace_with_a_secure_random_value
